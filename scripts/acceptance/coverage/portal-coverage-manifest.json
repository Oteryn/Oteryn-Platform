{
  "schema_version": 1,
  "contract": "ADR-0015",
  "description": "Every delivered named Oteryn portal route is classified exactly once. Coverage is risk-layered and never implies universal absence of defects or production proof.",
  "allowed_statuses": [
    "covered",
    "partial",
    "planned",
    "supporting_endpoint",
    "not_delivered"
  ],
  "required_viewports": [
    "desktop-1440x1000",
    "tablet-820x1180",
    "mobile-390x844"
  ],
  "route_name_exclusions": [
    {
      "prefix": "passport.",
      "reason": "Framework OAuth protocol endpoints are governed by dedicated Identity/API feature and security contracts, not standalone portal-page acceptance."
    },
    {
      "prefix": "oauth.",
      "reason": "Framework OAuth protocol endpoints are governed by dedicated Identity/API feature and security contracts, not standalone portal-page acceptance."
    },
    {
      "prefix": "sanctum.",
      "reason": "Framework authentication support endpoints are not delivered portal pages and remain covered at feature/security layer."
    },
    {
      "prefix": "ignition.",
      "reason": "Development diagnostics are not a delivered production portal surface."
    },
    {
      "exact": "storage.local",
      "reason": "Laravel local-storage delivery is a framework resource endpoint, not a standalone portal page; authorization and storage behavior remain covered by the consuming feature/security contracts."
    },
    {
      "exact": "storage.local.upload",
      "reason": "Laravel local-storage upload support is a framework transport endpoint, not a standalone portal page; upload authorization and validation remain owned by module feature/security contracts."
    }
  ],
