{
  "name": "oteryn-acceptance-e2e",
  "private": true,
  "version": "1.0.0",
  "type": "commonjs",
  "scripts": {
    "pretest": "npm run test:runtime-diagnostics",
    "test": "playwright test --project=chromium-primary --grep-invert \"Flow 3 — password recovery uses real test SMTP, revokes old sessions and rejects token replay|Password change — authenticated change revokes all existing sessions and requires the new password|Flow 5 — character validation, reserved/duplicate/quota/ownership/idempotency boundaries|Flow 6 — public game data, pagination, empty and controlled dependency-failure states\"",
    "pretest:smoke": "npm run test:runtime-diagnostics",
    "test:smoke": "playwright test --project=chromium-primary --grep @smoke",
    "test:runtime-diagnostics": "node --test unit/runtime-diagnostics.test.mjs",
    "test:account-lifecycle": "playwright test --project=chromium-primary --grep @portal-account --workers=1",
    "test:community-data": "playwright test --config=playwright.community-data.config.mjs",
    "test:content-scale": "playwright test --config=playwright.content-scale.config.mjs",
    "pretest:coverage-contract:strict": "node coverage/validate-portal-content-scale-evidence.mjs && node coverage/test-portal-content-scale-evidence.mjs",
    "test:content-scale-evidence": "node coverage/validate-portal-content-scale-evidence.mjs",
    "test:content-scale-evidence:fixtures": "node coverage/test-portal-content-scale-evidence.mjs",
    "test:downloads": "ACCEPTANCE_PROFILE=critical playwright test --project=chromium-primary --grep \"@portal-downloads complete public\" --workers=1",
    "test:downloads-portability": "playwright test --project=downloads-portability-firefox --project=downloads-portability-webkit --workers=1",
    "test:coverage-contract": "node coverage/validate-portal-coverage.mjs",
    "test:coverage-contract:manifest": "node coverage/validate-portal-coverage.mjs --manifest-only",
    "test:coverage-contract:strict": "node coverage/validate-portal-coverage.mjs --strict && node coverage/validate-product-completeness.mjs && node coverage/validate-backend-frontend-completeness.mjs && node coverage/test-backend-frontend-completeness.mjs && node coverage/validate-dimension-evidence.mjs && node coverage/test-dimension-evidence.mjs && node coverage/validate-portal-media-strict-closure.mjs && node coverage/test-portal-media-state-evidence.mjs && node coverage/validate-route-view-navigation-final.mjs && node coverage/test-route-view-navigation-final.mjs",
    "test:dimension-evidence": "node coverage/validate-dimension-evidence.mjs",
    "test:dimension-evidence:fixtures": "node coverage/test-dimension-evidence.mjs",
    "test:product-completeness": "node coverage/validate-product-completeness.mjs",
    "test:backend-frontend-completeness": "node coverage/validate-backend-frontend-completeness.mjs",
    "test:backend-frontend-completeness:fixtures": "node coverage/test-backend-frontend-completeness.mjs",
    "test:portability": "playwright test --project=portability-chromium --project=portability-firefox --project=portability-webkit",
    "test:responsive": "playwright test --project=responsive-desktop --project=responsive-tablet --project=responsive-mobile",
    "test:resilience": "playwright test --project=resilience-chromium --project=error-states-chromium-desktop --project=error-states-chromium-tablet --project=error-states-chromium-mobile --workers=1",
    "test:accessibility": "playwright test --project=accessibility-chromium",
    "test:soak": "playwright test --project=soak-chromium",
    "test:media-state-evidence": "node coverage/validate-portal-media-strict-closure.mjs",
    "test:media-state-evidence:fixtures": "node coverage/test-portal-media-state-evidence.mjs",
    "test:route-view-navigation": "node coverage/validate-route-view-navigation-final.mjs",
    "test:route-view-navigation:fixtures": "node coverage/test-route-view-navigation-final.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1"
  }
}
