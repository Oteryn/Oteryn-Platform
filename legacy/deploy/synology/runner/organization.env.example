# Organization-level product-isolated runner estate defined by Oteryn/Oteryn#34.
# Never place registration token values in this file.
#
# Create one-time token files outside the repository:
# - Platform/Atlas: owner root:root, mode 0600.
# - Game: owner UID/GID 1001, mode 0400 (or 0600) because the Game runner is non-root.
# Blank each file immediately after its runner is registered and before steady-state
# force-recreation. File-backed Compose secrets keep host ownership; Compose cannot
# remap uid/gid for this source type.
#
# RUNNER_IMAGE must be the exact canonical Oteryn GHCR digest produced from the
# reviewed source SHA before activation.
RUNNER_IMAGE=ghcr.io/oteryn/oteryn-deploy-runner@sha256:REQUIRED_IMMUTABLE_DIGEST
RUNNER_ORG_URL=https://github.com/Oteryn
PLATFORM_RUNNER_TOKEN_FILE=REQUIRED_LOCAL_PLATFORM_TOKEN_FILE
ATLAS_RUNNER_TOKEN_FILE=REQUIRED_LOCAL_ATLAS_TOKEN_FILE
GAME_RUNNER_TOKEN_FILE=REQUIRED_LOCAL_GAME_TOKEN_FILE
PLATFORM_STATE_HOST_PATH=/volume1/docker/oteryn/state
