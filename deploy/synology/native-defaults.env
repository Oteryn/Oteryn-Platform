# Committed, NON-SECRET defaults for the Synology staging native-login settings. Nothing here is a key,
# password or token; secrets stay in GitHub secrets and on the NAS.
#
# Precedence for each name: the GitHub repository variable of the same name (override) > this file >
# empty. A blank value means "not configured": the deploy then fails closed with a message naming the
# setting when native admission is on, and native admission stays off when it is not.
# Lines are read as data (KEY=VALUE, no quoting, no shell expansion).

# Native admission is opt-in. The three settings below are filled in, so it is on for staging.
OTERYN_STAGING_NATIVE_ADMISSION_ENABLED=true

# Native route publication (lib.sh oteryn_publish_native_route), on for staging since the PostgreSQL
# cutover (ADR 0044 Amendment P4, accepted 2026-10-14): each deploy issues (idempotently) the World and
# channel ids for Registry world row 1 and publishes the Game node route. Account-character projection
# is on (compose.yml platform), so the World id below is not a D171 character-world tie: the D171
# fallback stays off and the id is used only by the publication step, which refuses unless the
# Registry issues exactly this WorldId. Route values mirror Game deploy/synology-game/preprod-topology.toml
# ([scope] channel_key, [route] host, port, tls_server_name).
OTERYN_STAGING_NATIVE_ROUTE_PUBLISH_ENABLED=true
OTERYN_STAGING_NATIVE_WORLD_ID=01a12cf7-c826-728d-8945-95bf96df3e26
OTERYN_STAGING_NATIVE_CHANNEL_KEY=oteryn-staging-1
OTERYN_STAGING_NATIVE_ROUTE_HOST=192.168.1.2
OTERYN_STAGING_NATIVE_ROUTE_PORT=7172
OTERYN_STAGING_NATIVE_ROUTE_TLS_SERVER_NAME=node-1.preprod.oteryn.internal

# JSON, certificate subject to ["<WORLD_ID>/<CHANNEL_ID>"] scope list. The ids exist now (World
# 01a12cf7-c826-728d-8945-95bf96df3e26, channel 01a12cf7-c832-72f0-bb82-109de367acda).
OTERYN_STAGING_NATIVE_RUNTIME_STATUS_IDENTITIES={"CN=oteryn-preprod-node-1-runtime-status":["01a12cf7-c826-728d-8945-95bf96df3e26/01a12cf7-c832-72f0-bb82-109de367acda"]}
OTERYN_STAGING_NATIVE_SCOPE_ASSIGNMENT_IDENTITIES={"CN=oteryn-preprod-game-ops":["01a12cf7-c826-728d-8945-95bf96df3e26/01a12cf7-c832-72f0-bb82-109de367acda"]}

# Platform internal mTLS listener for the Game node (compose.yml internal-mtls, README: Platform
# internal mTLS listener): TLS 1.3, client certificate required, on the NAS LAN address the Game node
# dials (Game deploy/synology-game/preprod-topology.toml: 192.168.1.2:8543, peer name
# platform-internal.preprod.oteryn.internal). The three files are owner-placed host files mounted
# read-only, independent of tls-init: the server chain (issued by the long-lived preprod CA, SAN
# DNS:platform-internal.preprod.oteryn.internal), its key (root 0600) and the preprod CA that issues
# the Game node client certificates. Paths only; no key or certificate is in the repository.
OTERYN_STAGING_NATIVE_PLATFORM_MTLS_ENABLED=true
OTERYN_STAGING_NATIVE_PLATFORM_MTLS_BIND_ADDRESS=192.168.1.2
OTERYN_STAGING_NATIVE_PLATFORM_MTLS_PORT=8543
OTERYN_STAGING_NATIVE_PLATFORM_MTLS_SERVER_CERT_FILE=/volume1/oteryn/preprod-platform-tls/platform-internal-preprod.fullchain.pem
OTERYN_STAGING_NATIVE_PLATFORM_MTLS_SERVER_KEY_FILE=/volume1/oteryn/preprod-platform-tls/platform-internal-preprod.key
OTERYN_STAGING_NATIVE_PLATFORM_MTLS_CLIENT_CA_FILE=/volume1/oteryn/preprod-platform-tls/oteryn-preprod-ca.crt
# Game-node routes behind that listener whose Platform settings the deploy workflow does not render
# (compose.yml platform; lib.sh oteryn_resolve_game_node_route_settings). The environment file wins
# when it sets one; there is no repository-variable override for these. Blank means "not configured"
# and Platform answers the route 503 (fail closed). Each client identity is the RFC 2253 subject DN of
# the Game node certificate for that route. Native evidence and bootstrap-intent reads share the node's
# single [platform] client certificate (Game serve.rs), issued for preprod node 1 per the Game manifest
# deploy/synology-game/preprod-topology.toml; that identity is distinct from the runtime-status,
# scope-assignment and account-character identities.
# Native evidence (POST /internal/v1/game-auth/native-evidence): activation switch (true or false),
# client identity, fresh-account binding purpose and scope, clock uncertainty (0..5 seconds). Activation
# is one-way (OTERYN_V2_NATIVE_EVIDENCE_PRODUCER_CONTRACT.md) and stays false until the owner decides it;
# while false Platform answers evidence 503 whatever the bindings say.
OTERYN_STAGING_NATIVE_EVIDENCE_ACTIVATED=false
OTERYN_STAGING_NATIVE_EVIDENCE_MTLS_CLIENT_IDENTITY=CN=oteryn-preprod-node-1-native-evidence
OTERYN_STAGING_NATIVE_EVIDENCE_FRESH_ACCOUNT_PURPOSE=platform_security
OTERYN_STAGING_NATIVE_EVIDENCE_FRESH_ACCOUNT_SCOPE=fresh_admission
OTERYN_STAGING_NATIVE_EVIDENCE_CLOCK_UNCERTAINTY_SECONDS=1
# Character bootstrap intents (POST /internal/v1/game-auth/character-bootstrap-intents/read): client
# identity and intent TTL (1..300 seconds).
OTERYN_STAGING_NATIVE_BOOTSTRAP_INTENT_MTLS_CLIENT_IDENTITY=CN=oteryn-preprod-node-1-native-evidence
OTERYN_STAGING_NATIVE_BOOTSTRAP_INTENT_TTL_SECONDS=300
# Character Authority commands (Game contract oteryn-game-character-authority-commands-v1; runbook
# docs/operations/CHARACTER_AUTHORITY_COMMANDS_ENABLEMENT.md): POST
# /internal/v1/game-auth/character-commands/{pending,read,receipt} from the Game node's dedicated
# [platform.character_commands] client certificate, and the Account Center "Create character" form
# (web create). Both switches are off: Platform answers the three routes 503 and the form stays
# "temporarily unavailable". Turning them on is a reviewed change here, in the runbook's order:
# COMMANDS_ENABLED=true with COMMAND_IDENTITIES naming the issued certificate (JSON list of RFC 2253
# subject DNs, used by no other internal purpose), then WEB_CREATE_ENABLED=true after the Game smoke
# check. The source authority must equal Game [platform.character_commands].source_authority. The
# pending-intent bound is 40 (CP decision 2026-10-15, gate U-CC9): at 6 s per unseen key (read plus
# receipt) the 300 s TTL covers 41 keys (contract §4.1) and 40 keeps one key of margin. It is also the
# Platform code default, and Platform refuses a value above 40.
OTERYN_STAGING_NATIVE_CHARACTER_COMMANDS_ENABLED=true
OTERYN_STAGING_NATIVE_CHARACTER_COMMAND_IDENTITIES=["CN=oteryn-preprod-node-1-character-commands"]
OTERYN_STAGING_NATIVE_CHARACTER_COMMAND_SOURCE_AUTHORITY=oteryn:character-authority:primary
OTERYN_STAGING_NATIVE_CHARACTER_COMMAND_MAX_PENDING_INTENTS=40
OTERYN_STAGING_NATIVE_CHARACTER_WEB_CREATE_ENABLED=false
