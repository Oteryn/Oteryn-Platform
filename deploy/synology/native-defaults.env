# Committed, NON-SECRET defaults for the Synology staging native-login settings. Nothing here is a key,
# password or token; secrets stay in GitHub secrets and on the NAS.
#
# Precedence for each name: the GitHub repository variable of the same name (override) > this file >
# empty. A blank value means "not configured": the deploy then fails closed with a message naming the
# setting when native admission is on, and native admission stays off when it is not.
# Lines are read as data (KEY=VALUE, no quoting, no shell expansion).

# Native admission is opt-in. The three settings below are filled in, so it is on for staging.
OTERYN_STAGING_NATIVE_ADMISSION_ENABLED=true

# Native World UUIDv7 (lower case). Issued by the Registry (world row id 1, channel key
# oteryn-staging-1); its route rt.1.e96ce705077bfb6fc1c580175115b4c0 is already published on the NAS
# preproduction store. The deploy refuses native admission while this is blank or malformed.
OTERYN_STAGING_NATIVE_WORLD_ID=01a12cf7-c826-728d-8945-95bf96df3e26

# JSON, certificate subject to ["<WORLD_ID>/<CHANNEL_ID>"] scope list. The ids exist now (World
# 01a12cf7-c826-728d-8945-95bf96df3e26, channel 01a12cf7-c832-72f0-bb82-109de367acda).
OTERYN_STAGING_NATIVE_RUNTIME_STATUS_IDENTITIES={"CN=oteryn-preprod-node-1-runtime-status":["01a12cf7-c826-728d-8945-95bf96df3e26/01a12cf7-c832-72f0-bb82-109de367acda"]}
OTERYN_STAGING_NATIVE_SCOPE_ASSIGNMENT_IDENTITIES={"CN=oteryn-preprod-game-ops":["01a12cf7-c826-728d-8945-95bf96df3e26/01a12cf7-c832-72f0-bb82-109de367acda"]}
