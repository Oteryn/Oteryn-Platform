# Committed, NON-SECRET defaults for the Synology staging native-login settings. Nothing here is a key,
# password or token; secrets stay in GitHub secrets and on the NAS.
#
# Precedence for each name: the GitHub repository variable of the same name (override) > this file >
# empty. A blank value means "not configured": the deploy then fails closed with a message naming the
# setting when native admission is on, and native admission stays off when it is not.
# Lines are read as data (KEY=VALUE, no quoting, no shell expansion).

# Native admission is opt-in. Keep false until the three settings below are filled in.
OTERYN_STAGING_NATIVE_ADMISSION_ENABLED=false

# Native World UUIDv7 (lower case). Only known after the first Registry issue/route publish; the deploy
# refuses native admission while this is blank or malformed.
OTERYN_STAGING_NATIVE_WORLD_ID=

# JSON, certificate subject to ["<WORLD_ID>/<CHANNEL_ID>"] scope list. The ids exist only after the first
# route publish, so they cannot be committed in advance. Example shape (not a usable value):
# {"CN=<node runtime-status subject>":["<WORLD_ID>/<CHANNEL_ID>"]}
OTERYN_STAGING_NATIVE_RUNTIME_STATUS_IDENTITIES=
OTERYN_STAGING_NATIVE_SCOPE_ASSIGNMENT_IDENTITIES=
