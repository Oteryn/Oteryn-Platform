# Copy to .env outside Git history. Never commit the rendered file.
COMPOSE_PROJECT_NAME=oteryn-staging

# Safe defaults keep every published service on Synology loopback.
PLATFORM_BIND_ADDRESS=127.0.0.1
GATEWAY_BIND_ADDRESS=127.0.0.1
PLATFORM_PORT=8000
GATEWAY_PORT=8080

# Platform-owned authoritative route returned to OTClient after native login.
GAME_WORLD_ID=1
GAME_WORLD_SLUG=oteryn-staging
GAME_WORLD_NAME=Oteryn Staging
GAME_WORLD_REGION=LAN
GAME_WORLD_HOST=127.0.0.1
GAME_WORLD_PORT=7172

# Overall release/tooling identity is intentionally separate from component source
# identity. Automatic deployment writes these exact values from protected main.
OTERYN_RELEASE_SHA=REQUIRED_EXACT_40_CHAR_RELEASE_SHA
PLATFORM_SOURCE_SHA=REQUIRED_EXACT_40_CHAR_PLATFORM_SOURCE_SHA
GATEWAY_SOURCE_SHA=REQUIRED_EXACT_40_CHAR_GATEWAY_SOURCE_SHA

# Platform and Gateway images are built by GitHub Actions from this repository.
# Use the current repository owner in lowercase. Production-like deployment uses
# immutable digest references; these :main values are manual/local examples only.
OTERYN_GHCR_OWNER=REQUIRED_REPOSITORY_OWNER_LOWERCASE
PLATFORM_IMAGE=ghcr.io/${OTERYN_GHCR_OWNER}/oteryn-platform:main
GATEWAY_IMAGE=ghcr.io/${OTERYN_GHCR_OWNER}/oteryn-game-gateway:main
GATEWAY_VERSION=sha-REQUIRED_EXACT_40_CHAR_GATEWAY_SOURCE_SHA

# Platform application configuration. APP_URL is the canonical user-visible
# origin used by console, scheduler, notification and signed URL generation;
# loopback remains a separate private bind/origin concern.
APP_NAME=Oteryn Platform Staging
APP_ENV=staging
APP_DEBUG=false
APP_KEY=REQUIRED_GENERATE_LARAVEL_APP_KEY
APP_URL=https://oteryn.molehill.cloud
LOG_LEVEL=info
SESSION_SECURE_COOKIE=true

# MariaDB. Generate staging-only random values, preferably hex strings.
MARIADB_ROOT_PASSWORD=REQUIRED_RANDOM_HEX
PLATFORM_DB_NAME=oteryn_platform
PLATFORM_DB_USER=oteryn_platform
PLATFORM_DB_PASSWORD=REQUIRED_RANDOM_HEX

# Character Bazaar remains disabled until the separately authorized staging-control
# workflow has provisioned the exact transfer grant, dedicated escrow account and
# persistent scheduler.
MARKETPLACE_ENABLED=false

# Redis default/admin password.
REDIS_PASSWORD=REQUIRED_RANDOM_HEX

# Gateway -> Platform service credential. Plaintext belongs only to Gateway;
# Platform receives its SHA-256 digest.
OTERYN_PLATFORM_SERVICE_TOKEN=REQUIRED_RANDOM_HEX
GAME_AUTH_GATEWAY_SERVICE_TOKEN_SHA256=REQUIRED_SHA256_OF_PLATFORM_SERVICE_TOKEN
GAME_AUTH_GATEWAY_PREVIOUS_SERVICE_TOKEN_SHA256=

# Persistent rollback state for the self-hosted runner. This path is on the runner
# host, not inside Git. Override if the runner container mounts a different state path.
OTERYN_STATE_DIR=/var/lib/oteryn-staging-state
