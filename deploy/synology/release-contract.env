# Versioned staging deployment compatibility contract.
# Keep the schema identity unchanged only while both the current and immediately
# previous application releases are proven to operate against the same schema.
# Breaking/contract migrations MUST bump OTERYN_SCHEMA_COMPATIBILITY_ID.
OTERYN_MIGRATION_POLICY=expand-contract
OTERYN_SCHEMA_COMPATIBILITY_ID=platform-schema-v1
OTERYN_APP_ACCEPTS_SCHEMA_IDS=platform-schema-v1
