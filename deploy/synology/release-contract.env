# Versioned staging deployment compatibility contract.
# Keep the schema identity unchanged only while both the current and immediately
# previous application releases are proven to operate against the same schema.
# Breaking/contract migrations MUST bump OTERYN_SCHEMA_COMPATIBILITY_ID.
OTERYN_MIGRATION_POLICY=expand-contract
OTERYN_SCHEMA_COMPATIBILITY_ID=platform-schema-v1
OTERYN_APP_ACCEPTS_SCHEMA_IDS=platform-schema-v1
# Platform database engine (ADR 0046, docs/operations/PLATFORM_POSTGRES_MIGRATION_PLAN.md P4): mariadb or
# postgres. Read as data by lib.sh oteryn_platform_db_engine and from the Platform image by the candidate
# contract check, which refuses an image whose engine differs from the deploy's. P6 cutover step 2 set postgres
# (scripts/cutover-postgres.sh): merge it only after the cutover freeze is recorded. Until native re-enable (step 4)
# the rollback is a reviewed revert of this line to mariadb; lib.sh oteryn_require_cutover_deploy_window keeps an
# ordinary deploy off the stack while the cutover owns it.
PLATFORM_DB_ENGINE=postgres
