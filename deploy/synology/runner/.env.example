# Copy to .env only for first registration. Remove RUNNER_TOKEN from the project
# configuration after the runner appears online; the persistent runner_config volume
# retains the registered runner credentials.
#
# RUNNER_IMAGE and RUNNER_URL are explicit transfer-sensitive coordinates. Set them
# to the current repository owner/coordinate before first registration or image pull.
# An already registered runner keeps using the persistent .runner configuration even
# when RUNNER_URL is omitted during an ordinary restart.
RUNNER_GHCR_OWNER=REQUIRED_REPOSITORY_OWNER_LOWERCASE
RUNNER_IMAGE=ghcr.io/${RUNNER_GHCR_OWNER}/oteryn-deploy-runner:main
RUNNER_URL=REQUIRED_REPOSITORY_URL
RUNNER_NAME=oteryn-synology-staging
RUNNER_TOKEN=REQUIRED_ONE_TIME_REGISTRATION_TOKEN
OTERYN_STATE_HOST_PATH=/volume1/docker/oteryn/state
