# Preparation template for the organization-level split defined by Oteryn/Oteryn#34.
# Never commit real registration tokens. Supply them only for first registration and
# clear them after each persistent *_runner_config volume contains a registered runner.
# RUNNER_IMAGE must be replaced by the exact canonical Oteryn GHCR digest produced
# from the reviewed source SHA before activation.
RUNNER_IMAGE=ghcr.io/oteryn/oteryn-deploy-runner@sha256:REQUIRED_IMMUTABLE_DIGEST
RUNNER_ORG_URL=https://github.com/Oteryn
PLATFORM_RUNNER_TOKEN=
ATLAS_RUNNER_TOKEN=
GAME_RUNNER_TOKEN=
PLATFORM_STATE_HOST_PATH=/volume1/docker/oteryn/state
