{
	servers {
		# Trust client forwarding only from cloudflared (Cloudflare Tunnel) at its
		# fixed private address; nothing else may set X-Forwarded-For.
		trusted_proxies static 172.18.0.20
		trusted_proxies_strict
		# Native gameplay shares :443 by SNI and ALPN. A matching connection is
		# relayed as raw TCP, still encrypted, to the Game node's private
		# listener: no TLS termination here and no PROXY header (the node
		# accepts only TLS 1.3 with ALPN oteryn-game/1). Every other connection
		# continues to the HTTP app unchanged.
		listener_wrappers {
			layer4 {
				@gameplay tls {
					sni game.oteryn.com
					alpn oteryn-game/1
				}
				route @gameplay {
					proxy 172.18.0.11:7172
				}
			}
			tls
		}
	}
}

(tunnel_only) {
	# oteryn.com is served only through the Cloudflare Tunnel; a direct origin
	# connection (any peer other than cloudflared) is dropped.
	@not_tunnel not remote_ip 172.18.0.20
	abort @not_tunnel
}

oteryn.com {
	import tunnel_only
	encode zstd gzip
	# Preserve the native contract alias to the Rust authenticated API handler.
	@native_ticket path /v1/game-auth/tickets
	rewrite @native_ticket /api/v1/game-auth/tickets
	reverse_proxy platform:8080 {
		# Forward the client already resolved through the tunnel trust policy,
		# rather than exposing the cloudflared hop to the Rust allowlist.
		header_up X-Forwarded-For {client_ip}
	}
}

www.oteryn.com {
	redir https://oteryn.com{uri} 308
}

gateway.oteryn.com, login.oteryn.com {
	reverse_proxy platform:8081 {
		header_up X-Forwarded-For {client_ip}
	}
}

# Native gameplay reaches the Game node through the :443 layer4 relay above
# (SNI game.oteryn.com + ALPN oteryn-game/1). This HTTP site only keeps the
# ACME certificate that game-supervisor.py still installs on the node; it
# serves no game API.
game.oteryn.com {
	respond "Native gameplay uses TLS on :443 with ALPN oteryn-game/1." 404
}
