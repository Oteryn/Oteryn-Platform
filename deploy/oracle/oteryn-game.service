[Unit]
Description=Oteryn Game durable Docker supervisor
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
UMask=0077
ExecStart=/usr/bin/python3 /opt/oteryn-oracle/game-supervisor.py
Restart=on-failure
RestartSec=30
RestartPreventExitStatus=78
TimeoutStopSec=90

[Install]
WantedBy=multi-user.target
