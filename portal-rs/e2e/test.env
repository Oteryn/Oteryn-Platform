# Test-only configuration for e2e/harness.mjs (cross-repository E2E harness).
# No secrets live here: database URLs, keys and certificates are generated per
# run into the ignored output directory. A variable already set in the calling
# environment overrides the value below, but only for names listed in this file.
OTERYN_ENV=testing
APP_ENV=testing
RUST_LOG=info
OTERYN_PUBLIC_ORIGIN=http://localhost:18080
OTERYN_WEBAUTHN_RP_ID=localhost

# Native evidence producer (gateway contract §19.5; evidence producer contract).
GAME_AUTH_NATIVE_EVIDENCE_ENABLED=true
GAME_AUTH_NATIVE_EVIDENCE_ACTIVATED=true
GAME_AUTH_NATIVE_EVIDENCE_SOURCE_AUTHORITY=oteryn-platform-e2e
GAME_AUTH_NATIVE_EVIDENCE_FRESH_ACCOUNT_PURPOSE=platform_security
GAME_AUTH_NATIVE_EVIDENCE_FRESH_ACCOUNT_SCOPE=fresh_admission
GAME_AUTH_NATIVE_EVIDENCE_FRESH_KEY_PURPOSE=fresh_admission
GAME_AUTH_NATIVE_EVIDENCE_CLOCK_UNCERTAINTY_SECONDS=0
GAME_AUTH_NATIVE_RUNTIME_STATUS_ENABLED=true
GAME_AUTH_NATIVE_SCOPE_ASSIGNMENT_ENABLED=true
GAME_AUTH_CHARACTER_BOOTSTRAP_INTENT_ENABLED=true

# Character authority surfaces (testing/preproduction only).
PORTAL_CHARACTER_COMMANDS_ENABLED=true
PORTAL_CHARACTER_SERVICES_EXCHANGE_ENABLED=true
PORTAL_CHARACTER_SERVICES_PROJECTION_ENABLED=true
PORTAL_CHARACTER_COMMAND_SOURCE_AUTHORITY=oteryn-game-e2e
PORTAL_CHARACTER_SERVICES_PROJECTION_AUTHORITY=oteryn-game-e2e
PORTAL_GAME_RESTORE_NOTICE_ENABLED=true
PORTAL_GAME_RESTORE_NOTICE_SOURCE_AUTHORITY=oteryn-game-e2e
OTERYN_LCFA_ENABLED=true
OTERYN_LCFA_SOURCE_AUTHORITY=oteryn-game-e2e

# Store, premium and loyalty delivery.
PRODUCTS_ENTITLEMENTS_STORE_DELIVERY_ENABLED=true
PRODUCTS_ENTITLEMENTS_STORE_SOURCE_AUTHORITY=oteryn-platform-e2e
PRODUCTS_ENTITLEMENTS_PREMIUM_SNAPSHOT_ENABLED=true
PRODUCTS_ENTITLEMENTS_LOYALTY_SNAPSHOT_ENABLED=true
PRODUCTS_ENTITLEMENTS_LOYALTY_STREAM_ENABLED=true

# Sanctions, security revocations and public projections.
PORTAL_SANCTION_EXPORT_ENABLED=true
PORTAL_SECURITY_REVOCATION_EXPORT_ENABLED=true
PORTAL_PUBLIC_PROJECTIONS_ENABLED=true
PORTAL_PUBLIC_PROJECTIONS_AUTHORITY=oteryn-game-e2e

# Native login (tickets and admission).
PORTAL_GAME_TICKETS_ENABLED=true
PORTAL_NATIVE_ADMISSIONS_ENABLED=true

# Listeners. The harness binds loopback only.
PORTAL_E2E_HTTP_PORT=18080
PORTAL_E2E_INTERNAL_PORT=18543
