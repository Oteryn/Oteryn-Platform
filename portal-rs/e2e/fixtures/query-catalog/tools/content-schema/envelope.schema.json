{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["payload"],
  "additionalProperties": false,
  "properties": {
    "payload": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["code"],
        "additionalProperties": false,
        "properties": {
          "code": {"type": "string", "pattern": "^fixture[.][a-z-]+$"},
          "loot": {"$ref": "#/$defs/reference"},
          "level": {"type": "integer", "minimum": 1},
          "algorithm": {"const": "IndependentBernoulliPpm"},
          "entries": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["item", "probability_ppm", "min_count", "max_count"],
              "additionalProperties": false,
              "properties": {
                "item": {"$ref": "#/$defs/reference"},
                "probability_ppm": {"type": "integer", "minimum": 1, "maximum": 1000000},
                "min_count": {"type": "integer", "minimum": 1},
                "max_count": {"type": "integer", "minimum": 1}
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "reference": {
      "type": "object",
      "required": ["key"],
      "additionalProperties": false,
      "properties": {"key": {"type": "string", "pattern": "^fixture[.][a-z-]+$"}}
    }
  }
}
